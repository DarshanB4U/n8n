# Central Environment Variables for Tasker

# --- DATABASE (packages/db) ---
# The connection string for your PostgreSQL database
DATABASE_URL="postgresql://postgres:abcd1234@localhost:5432/postgres"

# --- BACKEND API (apps/api) ---
# Secret for JWT authentication
JWT_SECRET="generate_a_secure_random_string_here"
# Resend API Key or other email provider credential
Email_Cred="your_email_api_key_here"
# Publicly accessible URL of the backend API
Backend_URL="http://localhost:3000/api/v0"
# Environment mode (development/production)
NODE_ENV="development"

# --- FRONTEND (apps/web) ---
# Public backend URL for the client to connect to
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000/api/v0"

# --- REDIS (Infrastructure) ---
# Required if using workers/queues
REDIS_URL="redis://localhost:6379"
