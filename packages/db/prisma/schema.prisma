// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String        @id @default(uuid())
  name       String
  email      String        @unique
  createdAt  DateTime      @default(now())
  workflows  Workflow[]
  credential Credentials[]
}

model Workflow {
  id          String   @id @default(uuid())
  title       String
  isActive    Boolean  @default(false)
  enabled     Boolean  @default(false)
  description String?
  nodes       Json[]
  edges       Json[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId  String
  user    User      @relation(fields: [userId], references: [id])
  webhook Webhook[]

  @@index([userId])
}

enum CredentialTypes {
  TELEGRAM
  OpenAi
  EMAIL
}

model Webhook {
  id         String   @id @default(uuid())
  title      String
  method     String
  path       String
  header     String
  secret     String
  workflowID String
  workflow   Workflow @relation(fields: [workflowID], references: [id])
}

model Credentials {
  id             String          @id @default(uuid())
  title          String
  platform       CredentialTypes
  credentialData Json
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  userId         String
  user           User            @relation(fields: [userId], references: [id])
}
