model Form {
  id         String   @id @default(uuid())
  title      String
  FormData   Json[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  workflowId String   @unique
  Workflow   Workflow @relation(fields: [workflowId], references: [id])
}
